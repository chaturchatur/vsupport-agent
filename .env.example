# === VAPI ===
VAPI_API_KEY=your_vapi_private_key_from_dashboard
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_SECRET=your_shared_webhook_secret
VAPI_KB_ID=your_vapi_knowledge_base_id

# === n8n Cloud ===
N8N_API_KEY=your_n8n_api_key
N8N_WEBHOOK_BASE_URL=https://your-instance.app.n8n.cloud

# === Supabase ===
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# n8n Cloud uses the built-in Supabase node (REST API credential):
# Host: https://your-project-ref.supabase.co
# Service Role Key: (same as above)

# pre-call-context reads Supabase over REST using SUPABASE_URL above
# (resolved into the workflow at deploy time by scripts/deploy-n8n.sh).

# === Post-call alerts (escalations / negative sentiment) ===
# Recipient and sender of the alert email. Leave empty to skip the email;
# the follow_ups row is still written.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# ID of the SMTP credential created in n8n (Credentials -> SMTP)
N8N_SMTP_CREDENTIAL_ID=

# === Post-call claim-status SMS (Twilio) ===
# Leave empty to skip the SMS silently.
# The SID and auth token are entered into the n8n Twilio credential, not read by the workflow.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# ID of the Twilio credential created in n8n (Credentials -> Twilio)
N8N_TWILIO_CREDENTIAL_ID=
